# Legitimate binary test fixtures (upload validation / EXIF-stripping /
# malicious-file-rejection tests need real image and PDF bytes to test
# against). Reviewed 2026-08-04, contents are synthetic/known-safe.
# ---------------------------------------------------------------------------
path:^apps/api/test/fixtures/fake-document\.pdf$
path:^apps/api/test/fixtures/gps-tagged\.jpg$
path:^apps/api/test/fixtures/spoofed-script\.jpg$
path:^apps/api/test/fixtures/valid-100x100\.jpg$
path:^apps/api/test/fixtures/valid-2000x2000\.jpg$
path:^apps/api/test/fixtures/valid-50x50\.png$
path:^apps/web/src/app/favicon\.ico$
path:^tests/e2e/fixtures/photos/test-room\.jpg$
